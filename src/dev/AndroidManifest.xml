<!-- GoogleAppIndexingWarning triggers because the action-view intent-filter
     lives in the main manifest. The dev variant must not override provider
     authorities: the main manifest uses ${applicationId} and automatically
     includes the .dev suffix.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="GoogleAppIndexingWarning">
    <application />
</manifest>
